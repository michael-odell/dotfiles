**/.DS_Store
**/*.(zwc|tmp|swp)
**/*~

# not _presently_ managing asdf configurations
/.tool-versions

/.claude
/.cursor
# These seem to be system-specific and maybe not worth tracking anyway (?)
/.claude.json*

# Ignore myobsidian vault symlink
/obsidian


# The .config directory is a mix of saved and not
/.config/nvim/autoload
/.config/nvim/plugged
/.config/htop
/.config/iterm2
/.config/configstore/
/.config/gh/
/.config/op/
/.config/gcloud/
/.config/containers
/.config/wireshark
/.config/1Password

# The set of ssh keys I want available is machine-specific
/.config/1Password/ssh/agent.toml


# .zsh has all things zsh -- most should be version controlled, but ones that
# are generated should not.
/.zsh/debug
/.zsh/plugins


# System-local things shouldn't generally be shared
/.zshenv.local
/.zshrc.local
/.local
/.zsh_sessions


# Packager-related directories
/.gem
/.venv
/.swiftpm


# Potentially sensitive things shouldn't be stored
/.aws
/.docker
/.gnupg*
/.history
/.bash_history
/.ipython
/.kube
/.node_repl_history
/.oci
/.psql_history
/.python_history
/.sqlite_history
/.ssh
/.terraform.d
/.colima
/.lima
/.rancher


# Caches shouldn't be stored
/.cache
/tmp
/.viminfo
/.ansible
# .terminfo woudln't _have_ to be a cache, but that's how I've set it up for now
/.terminfo
/.wget-hsts
/.npm
/.fontconfig
/.zcompcache
/.zcompdump
/go


# Locations I manage via git that shoudln't be stored in this repo
/.dotfiles.git
/.etc.git
/src
/contrib
/.asdf
/.vscode

# macOS stuff
/Applications
/Desktop
/Documents
/Downloads
/Library
/Movies
/Music
/Pictures
/Public
/.Trash
/.cups
/.CFUserTextEncoding

/Dropbox
/.dropbox
/SynologyDrive
/Google\ Drive

# I don't use subversion for anything at the moment, but something keeps triggering generation of
# configuration for it, so ignore that.
/.subversion

/.bundle
/.rbenv
/.yarnrc
/node_modules
