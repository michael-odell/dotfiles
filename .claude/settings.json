    "allow": [
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cat)",
      "Bash(cue export *)",
      "Bash(cue fmt *)",
      "Bash(cue vet *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(exit *)",
      "Bash(gh release view *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git ls-tree *)",
      "Bash(git ls-tree)",
      "Bash(git show *)",
      "Bash(git show)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt -l .)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(just *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(perl *)",
      "Bash(pip show:*)",
      "Bash(python3 *)",
      "Bash(python3)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(wait)",
      "Bash(wc *)",
      "Bash(xargs ls:*)",
      "Bash(yq *)"
