  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "showThinkingSummaries": true,
  "theme": "light",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "gitAttribution": false
}
